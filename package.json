{
  "name": "core3-estetica-automotiva-template",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Template CORE 3 para sites de estética automotiva — demonstração conceitual Company Auto SPA (não oficial).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "qa": "node scripts/qa-browser.mjs",
    "novo-cliente": "node scripts/novo-cliente.mjs",
    "importar-fotos": "python3 -I scripts/importar-fotos.py",
    "importar-mosaico": "python3 -I scripts/importar-mosaico.py",
    "previa": "node scripts/build-previa.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.0",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
